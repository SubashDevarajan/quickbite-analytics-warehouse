# Copied to .env by `make up` on first run. Edit .env, not this file.

# First business day to process. Airflow back-fills every day from here to yesterday.
QB_START_DATE=2026-09-23
# Linux only: your user id, so files Airflow writes are owned by you (`id -u`).
AIRFLOW_UID=50000

# duckdb (free, local) or bigquery (needs the GCP setup in infra/terraform/README.md)
WAREHOUSE=duckdb
GCP_PROJECT=
GCS_BUCKET=
BQ_LOCATION=asia-south1
# Path *inside the container* to a service-account key placed in ./secrets/
GOOGLE_APPLICATION_CREDENTIALS=
